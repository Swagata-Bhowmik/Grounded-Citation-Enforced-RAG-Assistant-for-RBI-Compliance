# Streamlit secrets TEMPLATE — copy to `.streamlit/secrets.toml` and fill in.
# The real secrets.toml is git-ignored and must NEVER be committed.
#
# On Streamlit Community Cloud you don't create this file — you paste the same
# key into the app's  Settings -> Secrets  box, which injects it at runtime.

# Your free Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "AIza...your-key-here..."

# Optional: override the default model (defaults to gemini-flash-latest, a stable
# alias that always points to a current free-tier Gemini Flash model)
# GEMINI_MODEL = "gemini-flash-latest"
